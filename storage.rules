rules_version = '2';

// Raw dokumenty (HTML/PDF/text) zapisují jen Cloud Functions.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }
  }
}
